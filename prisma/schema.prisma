// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  student
  admin
}

enum SubscriptionType {
  free
  basic
  professional
  enterprise
}

enum BadgeCategory {
  completion
  streak
  skill
  achievement
}

// Companies table
model Company {
  id               String           @id @default(cuid())
  name             String
  subscriptionType SubscriptionType @default(free)
  seatLimit        Int              @default(10)
  activeSince      DateTime         @default(now())
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([name])
}

// Users table
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            UserRole         @default(student)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       String?
  progress        UserProgress[]
  badges          UserBadge[]
  assessments     UserAssessment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
  @@index([companyId])
  @@index([role])
}

// Courses table
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  githubPath  String
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(false)
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([orderIndex])
}

// Modules table
model Module {
  id               String         @id @default(cuid())
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  title            String
  description      String?
  githubPath       String
  orderIndex       Int            @default(0)
  estimatedMinutes Int            @default(30)
  progress         UserProgress[]
  assessments      Assessment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([courseId])
  @@index([orderIndex])
}

// UserProgress table (tracks user progress on modules)
model UserProgress {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  module               Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId             String
  completionPercentage Int      @default(0)
  lastAccessed         DateTime @default(now())
  timeSpent            Int      @default(0) // in seconds
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@index([lastAccessed])
}

// Badges table
model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  pointValue  Int           @default(10)
  category    BadgeCategory @default(achievement)
  iconClass   String        @default("trophy")
  requirement String? // JSON or text description of how to earn
  userBadges  UserBadge[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
}

// UserBadges table (junction table for users and badges)
model UserBadge {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  badge        Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId      String
  earnedAt     DateTime @default(now())
  pointsEarned Int

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([earnedAt])
}

// Assessments table
model Assessment {
  id              String           @id @default(cuid())
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        String
  title           String
  description     String?
  questions       Json // Array of question objects
  passingScore    Int              @default(70) // percentage
  timeLimit       Int? // in minutes, null means no limit
  userAssessments UserAssessment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([moduleId])
}

// UserAssessments table (tracks user assessment attempts)
model UserAssessment {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  score        Int        @default(0) // percentage
  attempts     Int        @default(1)
  passed       Boolean    @default(false)
  answers      Json? // User's answers
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, assessmentId])
  @@index([userId])
  @@index([assessmentId])
  @@index([passed])
}
